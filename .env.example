# Copie este arquivo para .env.local e preencha com os valores do
# app Web criado no Firebase Console (Configurações do projeto → Seus apps).
#
# .env.local NÃO vai para o GitHub (está no .gitignore).
# No GitHub Pages, os mesmos valores ficam em Settings → Secrets and variables → Actions.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (Google Analytics). Pode deixar em branco.
# VITE_FIREBASE_MEASUREMENT_ID=

# Só é necessário ao gerar o build para o GitHub Pages.
# O workflow define automaticamente; para testar localmente use /MainCourse/.
# VITE_BASE=/MainCourse/
